title=ManiGraB TV
major_version=1
minor_version=0
build_version=4

# Medidas exigidas por el analisis estatico de Roku (criterio 6.4). Los
# atributos mm_icon_side_hd/sd estan obsoletos y se quitaron.
mm_icon_focus_hd=pkg:/images/icon_focus_hd.png
mm_icon_focus_sd=pkg:/images/icon_focus_sd.png

splash_screen_fhd=pkg:/images/splash_fhd.jpg
splash_screen_hd=pkg:/images/splash_hd.jpg
splash_screen_sd=pkg:/images/splash_sd.jpg
splash_color=#071226
splash_min_time=0

ui_resolutions=hd

# Roku SceneGraph 1.3. Sin esto el canal corre en el modo antiguo y el
# analisis lo marca. Obliga a firmware minimo 15.1 en el dashboard.
rsg_version=1.3

# Deep linking: el canal tiene que poder arrancar desde una peticion
# externa (busqueda de Roku, "Continuar viendo", asistentes de voz).
# Obligatorio para certificar, criterio 5.2.
supports_input_launch=1

# Aqui vivia screensaver_title. Se quito: el criterio 4.5 prohibe que un
# canal ofrezca su propio salvapantallas o pise el del sistema, y el
# analisis estatico lo marco como ERROR dos veces. La escena y su punto
# de entrada RunScreenSaver tambien se eliminaron.
