        <field id="authToken" type="string" />
        <field id="result" type="assocarray" alwaysNotify="true" />
        <function name="StartLoading" />
    </interface>
    <children>
        <Rectangle color="#0B132B" width="1280" height="720" />
        <Label id="title" text="ManiGraB TV" translation="[60,32]" color="#FFD700" />
        <Label id="progressLabel" translation="[60,68]" color="#CCCCCC" text="" />
        <RowList id="rows" translation="[60,120]" rowItemSize="[[280,170]]" rowItemSpacing="[[24,0]]"
            rowHeights="[210]" rowSpacings="[16]" itemComponentName="SequenceCard"
            rowLabelColor="#FFD700" showRowLabel="[true]" />
        <Label id="loadingLabel" translation="[60,120]" color="#FFFFFF" text="Cargando..." />
        <ApiTask id="homeTask" />
        <ApiTask id="voiceTask" />
    </children>
    <script type="text/brightscript" uri="pkg:/components/Utils.brs" />
    <script type="text/brightscript" uri="pkg:/components/HomeScreen.brs" />
</component>
