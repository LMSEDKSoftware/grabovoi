<?xml version="1.0" encoding="utf-8" ?>
<!-- Pantalla en reposo del canal. Roku la arranca solo cuando el canal
     lleva rato sin actividad, en un proceso aparte del canal normal: no
     comparte nada con MainScene, no tiene sesion iniciada y no puede
     pedirle datos al servidor con el token del usuario. Por eso lo que
     muestra es fijo y local, sin llamadas de red.

     Se mueve a proposito (la esfera respira y el texto flota de sitio):
     una imagen quieta durante horas puede marcar paneles OLED, y Roku
     pide explicitamente que el salvapantallas tenga movimiento. -->
<component name="ScreensaverScene" extends="Scene">
    <children>
        <Rectangle color="#071226" width="1280" height="720" />
        <Poster id="fondo" width="1280" height="720" loadDisplayMode="scaleToFill" uri="pkg:/images/login_bg.jpg" />

        <Group id="flotante">
            <Poster id="logo" translation="[0,0]" width="220" height="150" loadDisplayMode="scaleToFit" uri="pkg:/images/manigrab_logo.png" />
            <Label id="marca" text="Secuencias Grabovoi" translation="[0,164]" width="360" color="#B9C4D8" />
            <Label id="frase" text="" translation="[0,200]" width="420" height="120" wrap="true" color="#FFD83D" />
        </Group>

        <Timer id="movimiento" duration="18" repeat="true" />
    </children>
    <script type="text/brightscript" uri="pkg:/components/ScreensaverScene.brs" />
</component>
