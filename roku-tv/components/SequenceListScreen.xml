<?xml version="1.0" encoding="utf-8" ?>
<component name="SequenceListScreen" extends="Group">
    <interface>
        <field id="authToken" type="string" />
        <field id="categoria" type="string" />
        <!-- Si endpointUri viene seteado, se usa tal cual (favoritos/
             top-usados: ya son una URL completa, no se arman desde una
             categoria) y titulo se muestra en vez del nombre de la
             categoria. Ver ShowFavoritos/ShowTopUsados en MainScene.brs. -->
        <field id="endpointUri" type="string" />
        <field id="titulo" type="string" />
        <field id="result" type="assocarray" alwaysNotify="true" />
        <function name="StartLoading" />
        <function name="RestoreFocus" />
    </interface>
    <children>
        <Rectangle color="#071226" width="1280" height="720" />
        <Label id="title" translation="[300,40]" color="#FFD83D" text="" />
        <Label id="countLabel" translation="[300,40]" width="940" horizAlign="right" color="#B9C4D8" text="" />
        <MarkupGrid id="grid" translation="[300,110]" itemSize="[280,170]" itemSpacing="[24,24]"
            numColumns="3" numRows="3" itemComponentName="SequenceCard" />
        <Label id="loadingLabel" translation="[300,110]" color="#F4F1E8" text="Cargando..." />
        <!-- Armar una combinacion: es la unica forma de crearlas hoy (la
             app movil todavia no las crea), asi que la pista tiene que
             estar a la vista o la funcion no existe para nadie. Ver
             onKeyEvent en el .brs.
             Va en la banda libre del encabezado, entre el titulo y el
             conteo: abajo se encimaba con la ultima fila de tarjetas. El
             titulo mas largo del canal ("Top ten mas usados") llega a
             unos 520, y el conteo arranca cerca de 1070, asi que este
             hueco da para unos 42 caracteres; los textos del .brs estan
             recortados a esa medida. -->
        <Label id="rutinaAviso" translation="[540,40]" width="510" horizAlign="center" color="#8A93A6" text="" />
        <ApiTask id="catalogTask" />
        <ApiTask id="rutinaTask" />
        <!-- Se piden las combinaciones existentes en el momento de
             guardar, no al abrir la pantalla: son datos que solo hacen
             falta si de verdad se va a guardar algo, y asi la lista
             refleja lo que hay ahora mismo. -->
        <ApiTask id="combinacionesTask" />
        <!-- Que secuencias ya son favoritas, para pintarles el corazon.
             Se consulta en paralelo al catalogo y se aplica cuando
             llegan las dos: cual conteste primero depende de la red. -->
        <ApiTask id="favoritosTask" />
    </children>
    <script type="text/brightscript" uri="pkg:/components/Utils.brs" />
    <script type="text/brightscript" uri="pkg:/components/SequenceListScreen.brs" />
</component>
