<?xml version="1.0" encoding="utf-8" ?>
<!-- Cortinilla de apertura: video corto (roku-tv/video/intro.mp4, ya
     trae el audio de audio/intro.mp3 mezclado, generado con
     scripts/generar_intro.py) que se reproduce una vez al abrir el
     canal, antes de Login/Inicio. Cualquier tecla la salta. -->
<component name="IntroScreen" extends="Group">
    <interface>
        <field id="result" type="assocarray" alwaysNotify="true" />
        <function name="StartLoading" />
    </interface>
    <children>
        <Rectangle color="#071226" width="1280" height="720" />
        <Video id="video" translation="[0,0]" width="1280" height="720" />
        <!-- Rescate. El video dura 6 s; si a los 12 no ha terminado ni ha
             dado error, se pasa de largo igualmente. Una cortinilla que
             se atasca no puede dejar el canal encerrado sin llegar nunca
             al login: es decoracion, no un paso obligatorio. -->
        <Timer id="rescate" duration="12" repeat="false" />
    </children>
    <script type="text/brightscript" uri="pkg:/components/IntroScreen.brs" />
</component>
