<?xml version="1.0" encoding="utf-8" ?>
<component name="CategoryScreen" extends="Group">
    <interface>
        <field id="authToken" type="string" />
        <field id="result" type="assocarray" alwaysNotify="true" />
        <function name="StartLoading" />
    </interface>
    <children>
        <Rectangle color="#0B132B" width="1280" height="720" />
        <Label id="title" text="Explorar por categoria" translation="[60,40]" color="#FFD700" />
        <MarkupGrid id="grid" translation="[60,110]" itemSize="[280,170]" itemSpacing="[24,24]"
            numColumns="4" numRows="3" itemComponentName="SequenceCard" />
        <Label id="loadingLabel" translation="[60,110]" color="#FFFFFF" text="Cargando..." />
        <ApiTask id="catalogTask" />
    </children>
    <script type="text/brightscript" uri="pkg:/components/Utils.brs" />
    <script type="text/brightscript" uri="pkg:/components/CategoryScreen.brs" />
</component>
