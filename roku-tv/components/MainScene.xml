<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
    <interface>
    </interface>
    <children>
        <Rectangle id="background" color="#071226" width="1280" height="720" />

        <!-- Las pantallas (Home/Categorias/Lista/Reproductor/Login) se
             intercambian aqui adentro, nunca directo en el Scene, asi
             el sidebar (declarado despues) siempre queda encima sin
             importar que pantalla este activa. -->
        <Group id="content" />

        <!-- Sidebar permanente. Se oculta solo en el login (sin cuenta
             vinculada todavia no hay nada que navegar). Home/Library
             navegan de verdad; el resto queda visible pero inerte hasta
             que existan esas pantallas. Se enfoca con el boton Options o
             con "izquierda" (cuando el contenido ya no tiene a donde
             moverse mas a la izquierda), ver onKeyEvent. -->
        <Group id="sidebar" visible="false">
            <Rectangle color="#0C1830" width="270" height="720" />
            <!-- Logo + "TV" en vez del texto "MANIGRAB TV" (pedido
                 explicito). El logo trae su propio padding transparente
                 centrado (ver roku-tv/images/manigrab_logo.png), asi que
                 una caja chica con scaleToFit ya lo deja como un icono
                 compacto sin recortarlo a mano. -->
            <Poster id="sidebarLogo" translation="[30,32]" width="96" height="68" loadDisplayMode="scaleToFit" uri="pkg:/images/manigrab_logo.png" />
            <Label text="TV" color="#FFD83D" translation="[134,50]" width="120" height="30" />
            <!-- LabelList nativo, identico al commit 44cff0f: sin
                 rectangulo propio, el foco lo dibuja Roku solo.
                 "Informacion Legal" es el ultimo item, parte de la
                 misma lista (pedido explicito: debe navegarse igual que
                 el resto, sin color especial si eso rompe la seleccion). -->
            <LabelList id="sidebarList" translation="[20,154]" itemSize="[230,44]" itemSpacing="[0,2]"
                color="#B9C4D8" focusedColor="#0C1830" />
        </Group>

        <ApiTask id="checkSessionTask" />
    </children>
    <script type="text/brightscript" uri="pkg:/components/Utils.brs" />
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
</component>
