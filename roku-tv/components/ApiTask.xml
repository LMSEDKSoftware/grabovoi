<?xml version="1.0" encoding="utf-8" ?>
<component name="ApiTask" extends="Task">
    <interface>
        <field id="uri" type="string" />
        <field id="method" type="string" value="GET" />
        <field id="body" type="string" />
        <field id="authToken" type="string" />
        <!-- Un solo campo atómico con {code, json}, en vez de dos campos
             separados: evitar cualquier duda sobre si el observador
             llega a leer responseJson antes de que esté listo. -->
        <field id="done" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/ApiTask.brs" />
</component>
